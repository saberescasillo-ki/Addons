{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.steel_crossbow": {
            "geometry": "Geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "part_visibility": [
                {
                    "arrow": "variable.arrow"
                }
            ],
            "textures": [
                "Texture.default"
            ]
        },
        "controller.render.steel_bow": {
            "geometry": "Geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "part_visibility": [
                {
                    "arrow": "variable.arrow && query.main_hand_item_use_duration != 0 && !v.first_person || variable.arrow && v.first_person"
                }
            ],
            "textures": [
                "Texture.default"
            ]
        }
    }
}