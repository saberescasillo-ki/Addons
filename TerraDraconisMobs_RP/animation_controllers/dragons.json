{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.wyverns": {
            "initial_state": "default",
            "states": {
                "default": {
                    "animations": [
                        "idle"
                    ],
                    "blend_transition":0.3,
                    "transitions": [
                        {
                            "walk" : "query.ground_speed > 0.5 && !query.has_target"
                        },
                        {
                            "run":"query.ground_speed > 0.5 && query.has_target"
                        },
                        {
                            "fly":"query.property('flying:property') && !query.is_on_ground && query.vertical_speed > 0"
                        },
                        {
                            "glide":"query.property('flying:property') && !query.is_on_ground && query.vertical_speed <= -0.1 && query.property('flying:property') && query.rider_head_x_rotation(0) > -80"
                        },
                        {
                            "dive":"query.property('flying:property') && !query.is_on_ground  && query.vertical_speed <= -0.1 && query.rider_head_x_rotation(0) > 60 && query.property('flying:property')"
                        },
                        {
                            "swim":"query.is_in_water"
                        }
                    ]
                },
                "walk":{
                    "animations": [
                        "walk"
                    ],
                    "blend_transition":0.3,
                    "transitions": [
                        {
                            "default": "query.ground_speed <= 0"
                        },
                        {
                            "run":"query.ground_speed > 0.5 && query.has_target"
                        },
                        {
                            "swim":"query.is_in_water"
                        },
                        {
                            "fly":"query.property('flying:property') && !query.is_on_ground && query.vertical_speed > 0"
                        },
                        {
                            "glide":"query.property('flying:property') && !query.is_on_ground && query.vertical_speed <= -0.1 && query.property('flying:property') && query.rider_head_x_rotation(0) > -80"
                        },
                        {
                            "dive":"query.property('flying:property') && !query.is_on_ground  && query.vertical_speed <= -0.1 && query.rider_head_x_rotation(0) > 60 && query.property('flying:property')"
                        }
                    ]
                },
                "swim":{
                    "animations": [
                        "swim",
                        "swim_sound"
                    ],
                    "blend_transition":0.3,
                    "transitions": [
                        {
                            "default": "!query.is_in_water"
                        }
                    ]
                },
                "run":{
                    "animations": [
                        "run"
                    ],
                    "blend_transition":0.3,
                    "transitions": [
                        {
                            "default": "query.ground_speed <= 0"
                        },
                        {
                            "walk" : "query.ground_speed > 0.5 && !query.has_target"
                        },
                        {
                            "fly":"query.property('flying:property') && !query.is_on_ground && query.vertical_speed > 0"
                        },
                        {
                            "glide":"query.property('flying:property') && !query.is_on_ground && query.vertical_speed <= -0.1 && query.property('flying:property') && query.rider_head_x_rotation(0) > -80"
                        },
                        {
                            "swim":"query.is_in_water"
                        },
                        {
                            "dive":"query.property('flying:property') && !query.is_on_ground  && query.vertical_speed <= -0.1 && query.rider_head_x_rotation(0) > 60 && query.property('flying:property')"
                        }
                    ]
                },
                "fly":{
                    "animations": [
                        "fly",
                        "wing_sound"
                    ],
                    "blend_transition":0.2,
                    "transitions": [
                        {
                            "default": "query.ground_speed <= 0 || query.is_on_ground"
                        },
                        {
                            "swim":"query.is_in_water"
                        },
                        {
                            "glide":"query.property('flying:property') && !query.is_on_ground && query.vertical_speed <= -0.1 && query.property('flying:property') && query.rider_head_x_rotation(0) > -80"
                        }
                    ]
                },
                "glide":{
                    "animations": [
                        "glide"
                    ],
                    "blend_transition":0.5,
                    "transitions": [
                        {
                            "default": "query.ground_speed <= 0 || query.is_on_ground"
                        },
                        {
                            "fly":"query.property('flying:property') && !query.is_on_ground && query.vertical_speed > 0 && query.property('flying:property') && query.rider_head_x_rotation(0) > -80"
                        },
                        {
                            "swim":"query.is_in_water"
                        },
                        {
                            "dive":"query.property('flying:property') && !query.is_on_ground  && query.vertical_speed <= -0.1 && query.rider_head_x_rotation(0) > 60 && query.property('flying:property')"
                        }
                    ]
                },
                "dive":{
                    "animations": [
                        "dive"
                    ],
                    "blend_transition":0.5,
                    "transitions": [
                        {
                            "default": "query.ground_speed <= 0 || query.is_on_ground"
                        },
                        {
                            "swim":"query.is_in_water"
                        },
                        {
                            "glide":"query.property('flying:property') && !query.is_on_ground && query.vertical_speed <= -0.1 && query.rider_head_x_rotation(0) <= 60 && query.property('flying:property')"
                        }
                    ]
                }
            }
        },
        "controller.animation.wind_sound":{
            "initial_state": "default",
            "states": {
                "default":{
                    "transitions": [
                        {
                            "fly": "query.property('flying:property')"
                        }
                    ]
                },
                "fly":{
                    "animations": [
                        "wind_sound"
                    ],
                    "transitions": [
                        {
                            "default": "!query.property('flying:property')"
                        }
                    ]
                }
            }
        },
        "controller.animation.wyverns_attack":{
            "initial_state": "setup",
            "states": {
                "setup":{
                    "blend_transition":0.5,
                    "transitions": [
                        {
                            "bite": "query.is_delayed_attacking && variable.melee_var == 0"
                        },
                        {
                            "bite2": "query.is_delayed_attacking && variable.melee_var == 1"
                        },
                        {
                            "bite3": "query.is_delayed_attacking && variable.melee_var == 2"
                        },
                        {
                            "bite4": "query.is_delayed_attacking && variable.melee_var == 3"
                        },
                        {
                            "bite5": "query.is_delayed_attacking && variable.melee_var == 4"
                        },
                        {
                            "fire_breath":"query.facing_target_to_range_attack"
                        }
                    ]
                },
                "fire_breath":{
                    "blend_transition":0.1,
                    "animations": [
                        "fire_breath"
                    ],
                    "transitions": [
                        {
                            "setup": "!query.facing_target_to_range_attack"
                        }
                    ]
                },
                "bite":{
                    "blend_transition":0.1,
                    "animations": [
                        "bite"
                    ],
                    "transitions": [
                        {
                            "setup": "query.any_animation_finished"
                        }
                    ]
                },
                "bite2":{
                    "blend_transition":0.1,
                    "animations": [
                        "bite2"
                    ],
                    "transitions": [
                        {
                            "setup": "query.any_animation_finished"
                        }
                    ]
                },
                "bite3":{
                    "blend_transition":0.1,
                    "animations": [
                        "bite3"
                    ],
                    "transitions": [
                        {
                            "setup": "query.any_animation_finished"
                        }
                    ]
                },
                "bite4":{
                    "blend_transition":0.1,
                    "animations": [
                        "bite4"
                    ],
                    "transitions": [
                        {
                            "setup": "query.any_animation_finished"
                        }
                    ]
                },
                "bite5":{
                    "blend_transition":0.1,
                    "animations": [
                        "bite5"
                    ],
                    "transitions": [
                        {
                            "setup": "query.any_animation_finished"
                        }
                    ]
                },
                "bite6":{
                    "blend_transition":0.1,
                    "animations": [
                        "bite6"
                    ],
                    "transitions": [
                        {
                            "setup": "query.any_animation_finished"
                        }
                    ]
                },
                "bite7":{
                    "blend_transition":0.1,
                    "animations": [
                        "bite7"
                    ],
                    "transitions": [
                        {
                            "setup": "query.any_animation_finished"
                        }
                    ]
                }
            }
        },
        "controller.animation.wyverns_idle_var":{
            "initial_state": "setup",
            "states": {
                "setup":{
                    "blend_transition":0.5,
                    "transitions": [
                        {
                            "var1": "query.anim_time > 5 && variable.idle_var == 1 && query.ground_speed <= 0"
                        },
                        {
                            "var2": "query.anim_time > 5 && variable.idle_var == 2 && query.ground_speed <= 0"
                        },
                        {
                            "var3": "query.anim_time > 5 && variable.idle_var == 3 && query.ground_speed <= 0"
                        },
                        {
                            "var4": "query.anim_time > 5 && variable.idle_var == 4 && query.ground_speed <= 0"
                        },
                        {
                            "var5": "query.anim_time > 5 && variable.idle_var == 5 && query.ground_speed <= 0"
                        }
                    ]
                },
                "var1":{
                    "animations": [
                        "idle_var1"
                    ],
                    "transitions": [
                        {
                            "cooldown": "query.any_animation_finished"
                        }
                    ]
                },
                "var2":{
                    "animations": [
                        "idle_var2"
                    ],
                    "transitions": [
                        {
                            "cooldown": "query.any_animation_finished"
                        }
                    ]
                },
                "var3":{
                    "animations": [
                        "idle_var3"
                    ],
                    "transitions": [
                        {
                            "cooldown": "query.any_animation_finished"
                        }
                    ]
                },
                "var4":{
                    "animations": [
                        "idle_var4"
                    ],
                    "transitions": [
                        {
                            "cooldown": "query.any_animation_finished"
                        }
                    ]
                },
                "var5":{
                    "animations": [
                        "idle_var5"
                    ],
                    "transitions": [
                        {
                            "cooldown": "query.any_animation_finished"
                        }
                    ]
                },
                "cooldown":{
                    "animations": [
                        "cooldown"
                    ],
                    "transitions": [
                        {
                            "setup": "query.any_animation_finished"
                        }
                    ]
                }
            }
        },
        "controller.animation.crimson_racer.phase_aura":{
            "initial_state": "phase1",
            "states": {
                "phase1":{
                    "transitions": [
                        {
                            "phase2": "query.health <= 250"
                        }
                    ]
                },
                "phase2":{
                    "animations": [
                        "phase_aura"
                    ],
                    "transitions": [
                        {
                            "phase1": "query.health > 250"
                        }
                    ]
                }
            }
        },
        "controller.animation.savage_crimson_racer.phase_aura":{
            "initial_state": "phase1",
            "states": {
                "phase1":{
                    "transitions": [
                        {
                            "phase2": "query.health <= 550"
                        }
                    ]
                },
                "phase2":{
                    "animations": [
                        "phase_aura"
                    ],
                    "transitions": [
                        {
                            "phase1": "query.health > 550"
                        }
                    ]
                }
            }
        },
        "controller.animation.crimson_racer.faint":{
            "initial_state": "default",
            "states": {
                "default":{
                    "transitions": [
                        {
                            "start_faint": "query.property('faint:property')"
                        }
                    ]
                },
                "start_faint":{
                    "animations": [
                        "start_faint"
                    ],
                    "transitions": [
                        {
                            "faint": "query.property('faint:property') && query.any_animation_finished"
                        }
                    ]
                },
                "faint":{
                    "animations": [
                        "faint"
                    ],
                    "transitions": [
                        {
                            "wake": "!query.property('faint:property')"
                        }
                    ]
                },
                "wake":{
                    "animations": [
                        "wake"
                    ],
                    "transitions": [
                        {
                            "default": "!query.property('faint:property') && query.any_animation_finished"
                        }
                    ]
                }
            }
        }
    }
}