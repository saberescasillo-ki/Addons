{
    "format_version": "1.10.0",
    "minecraft:attachable": {
        "description": {
            "identifier": "terradraconis:steel_sword",
            "materials": {
                "default": "entity_custom"
            },
            "textures": {
                "default": "textures/attachables/steel_sword_texture"
            },
            "animations": {
                "1st":"animation.steel_axe.sword_1st",
                "3st":"animation.steel_axe.tool_3st"
            },
            "scripts": {
                "initialize": [
                    "variable.attack= 0;"
                ],
                "pre_animation": [
                    "variable.attack= query.main_hand_item_use_duration;"
                ],
                "animate": [
                    {
                        "1st":"c.is_first_person"
                    },
                    {
                        "3st":"!c.is_first_person"
                    }
                ]
            },
            "enable_attachables": true,
            "geometry": {
                "default": "geometry.steel_sword"
            },
            "render_controllers": [
                "controller.render.default"
            ]
        }
    }
}