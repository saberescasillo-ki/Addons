            "deals_damage": "no"
          },
          {
            "cause": "lava",
            "deals_damage": "no"
          },
          {
            "cause": "magma",
            "deals_damage": "no"
          },
          {
            "cause": "freezing",
            "deals_damage": "no"
          },
          {
            "cause": "drowning",
            "deals_damage": "no"
          },
          {
            "cause": "wither",
            "deals_damage": "no"
          },
          {
