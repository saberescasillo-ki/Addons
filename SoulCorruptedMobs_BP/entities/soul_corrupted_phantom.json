        "ignore_visibility": true,
        "max_dist": 16,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "ocelot"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "cat"
                }
              ]
            }
          }
        ]
      },
      "minecraft:behavior.circle_around_anchor": {
