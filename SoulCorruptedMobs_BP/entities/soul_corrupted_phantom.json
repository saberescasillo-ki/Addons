          "min": 3,
          "max": 8
        },
        "height_offset_range": {
          "min": -2,
          "max": 3
        },
        "height_above_target_range": {
          "min": 6,
          "max": 12
        }
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "reselect_targets": true,
        "scan_interval": 10,
        "target_search_height": 120,
