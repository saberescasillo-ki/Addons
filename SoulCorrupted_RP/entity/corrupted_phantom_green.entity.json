{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "soul:corrupted_phantom_green",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/soul/corrupted_phantom_green"
      },
      "geometry": {
        "default": "geometry.soul.corrupted_phantom"
      },
      "animations": {
        "look": "animation.soul.look_at_target",
        "controller": "controller.animation.soul.phantom",
        "soul_particles": "animation.soul.soul_particles",
        "phantom_spawn": "animation.soul.phantom_spawn",
        "phantom_fly": "animation.soul.phantom_fly"
      },
      "particle_effects": {
        "wisps": "soul:wisp_green",
        "drips": "soul:drip_green",
        "burst": "soul:burst_green"
      },
      "scripts": {
        "pre_animation": [
          "variable.s_speed = math.lerp(variable.s_speed ?? 0.0, query.modified_move_speed, 0.1);",
          "variable.s_turn = math.lerp(variable.s_turn ?? 0.0, math.clamp(query.yaw_speed, -120.0, 120.0), 0.05);",
          "variable.s_attack = math.lerp(variable.s_attack ?? 0.0, math.sin(variable.attack_time * 180.0), 0.35);"
        ],
        "animate": [
          "look",
          "controller",
          "soul_particles"
        ]
      },
      "render_controllers": [
        "controller.render.soul.default"
      ],
      "spawn_egg": {
        "base_color": "#ace9b0",
        "overlay_color": "#21923a"
      }
    }
  }
}
