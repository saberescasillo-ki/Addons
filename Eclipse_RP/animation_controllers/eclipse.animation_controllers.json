{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.eclipse.pose": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "point": "q.property('eclipse:anim') == 1"
            },
            {
              "raise": "q.property('eclipse:anim') == 2"
            },
            {
              "spin": "q.property('eclipse:anim') == 3"
            },
            {
              "cross": "q.property('eclipse:anim') == 4"
            },
            {
              "summon": "q.property('eclipse:anim') == 5"
            },
            {
              "charge": "q.property('eclipse:anim') == 6"
            },
            {
              "release": "q.property('eclipse:anim') == 7"
            },
            {
              "vanish": "q.property('eclipse:anim') == 8"
            },
            {
              "appear": "q.property('eclipse:anim') == 9"
            },
            {
              "phase": "q.property('eclipse:anim') == 10"
            },
            {
              "ult_charge": "q.property('eclipse:anim') == 11"
            },
            {
              "ult_release": "q.property('eclipse:anim') == 12"
            },
            {
              "exhausted": "q.property('eclipse:anim') == 13"
            },
            {
              "slam": "q.property('eclipse:anim') == 14"
            },
            {
              "dash": "q.property('eclipse:anim') == 15"
            },
            {
              "laugh": "q.property('eclipse:anim') == 16"
            }
          ]
        },
        "point": {
          "animations": [
            "point"
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "idle": "q.property('eclipse:anim') != 1"
            }
          ]
        },
        "raise": {
          "animations": [
            "raise"
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "idle": "q.property('eclipse:anim') != 2"
            }
          ]
        },
        "spin": {
