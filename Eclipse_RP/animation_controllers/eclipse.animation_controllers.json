    "controller.animation.eclipse.aura": {
      "initial_state": "off",
      "states": {
        "off": {
          "transitions": [
            {
              "p1": "!q.property('eclipse:hidden') && q.is_alive && q.property('eclipse:phase') == 1"
            },
            {
              "p2": "!q.property('eclipse:hidden') && q.is_alive && q.property('eclipse:phase') == 2"
            },
            {
              "p3": "!q.property('eclipse:hidden') && q.is_alive && q.property('eclipse:phase') == 3"
            }
          ]
        },
        "p1": {
          "particle_effects": [
            {
              "effect": "aura1"
            }
          ],
          "transitions": [
            {
              "off": "!(!q.property('eclipse:hidden') && q.is_alive) || q.property('eclipse:phase') != 1"
            }
          ]
        },
        "p2": {
          "particle_effects": [
            {
              "effect": "aura2"
            }
          ],
          "transitions": [
            {
              "off": "!(!q.property('eclipse:hidden') && q.is_alive) || q.property('eclipse:phase') != 2"
            }
