{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:decal_zone",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/eclipse/particle/decal_zone"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 18
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.clamp(v.radius + v.speed * v.particle_age, 0.01, v.size)",
          "math.clamp(v.radius + v.speed * v.particle_age, 0.01, v.size)"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            256,
            256
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r",
          "v.color.g",
          "v.color.b",
          "v.color.a * math.clamp(v.particle_age * 10, 0, 1) * math.clamp((v.particle_lifetime - v.particle_age) * 6, 0, 1)"
        ]
      }
    }
  }
}
