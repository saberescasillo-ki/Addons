        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r",
          "v.color.g",
          "v.color.b",
          "v.color.a"
