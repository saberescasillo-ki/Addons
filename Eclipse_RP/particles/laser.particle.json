{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:laser",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/eclipse/particle/laser"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.radius * (1 - v.speed * v.particle_age / v.particle_lifetime)",
          "v.size"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.dir.direction_x",
            "v.dir.direction_y",
            "v.dir.direction_z"
          ]
        },
        "uv": {
          "texture_width": 32,
          "texture_height": 4,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            4
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r",
          "v.color.g",
          "v.color.b",
          "v.color.a * math.clamp(v.particle_age * 30, 0, 1) * math.clamp((v.particle_lifetime - v.particle_age) * 12, 0, 1)"
        ]
      }
    }
  }
}
