{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.flee_controllers": {
            "initial_state": "default",
            "states": {
                "default": {
                    "on_entry": [
                        "/event entity @s stop_flee"
                    ],
                    "transitions": [
                        {
                            "flee":"query.is_avoiding_mobs"
                        }
                    ]
                },
                "flee":{
                    "animations": [
                        "flee"
                    ],
                    "transitions": [
                        {
                            "default": "!query.is_avoiding_mobs"
                        }
                    ]
                }
            }
        }
    }
}