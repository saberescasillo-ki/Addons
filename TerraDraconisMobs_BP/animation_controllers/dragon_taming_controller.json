{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dragon_taming_controllers": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "taming": "query.property('faint:property')"
                        }
                    ]
                },
                "taming":{
                    "animations": [
                        "taming"
                    ],
                    "transitions": [
                        {
                            "default": "!query.property('faint:property')"
                        }
                    ]
                }
            }
        }
    }
}