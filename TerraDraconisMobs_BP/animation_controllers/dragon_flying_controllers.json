{"format_version":"1.10.0","animation_controllers":{"controller.animation.dragon_flying_controllers":{"initial_state":"default","states":{"default":{"transitions":[{"fly":"query.has_dash_cooldown && (query.has_rider ? query.rider_head_x_rotation(0) : 0) > -80"}]},"fly":{"on_entry":["/event entity @s fly","/stopsound @p wind_sound"],"on_exit":["/event entity @s landed","/stopsound @p wind_sound"],"animations":["fly_interval"],"transitions":[{"default":"query.is_on_ground || !query.has_rider || query.ground_speed < 5 && !query.is_on_ground"}]}}},"controller.animation.dragon_camera_controllers":{"initial_state":"default","states":{"default":{"transitions":[{"free_cam":"query.has_rider"}]},"free_cam":{"on_entry":["/camera @a[r=16, c=1] set minecraft:follow_orbit entity_offset 0 3 -5"],"on_exit":["/camera @a[r=16, c=1] clear"],"transitions":[{"default":"!query.has_rider"}]}}}}}