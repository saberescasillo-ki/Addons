{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.eu_sc.zombie": {
      "initial_state": "start",
      "states": {
        "start": {
          "transitions": [
            {
              "emerging": "query.property('eu_sc:emerging')"
            },
            {
              "alive": "!query.property('eu_sc:emerging')"
            }
          ]
        },
        "emerging": {
          "animations": [
            "zombie_spawn"
          ],
          "particle_effects": [
            {
              "effect": "burst"
            }
          ],
          "transitions": [
            {
              "alive": "!query.property('eu_sc:emerging')"
            }
          ],
          "blend_transition": 0.3
        },
        "alive": {
          "animations": [
            "zombie_life"
          ],
          "blend_transition": 0.3
        }
      }
    },
