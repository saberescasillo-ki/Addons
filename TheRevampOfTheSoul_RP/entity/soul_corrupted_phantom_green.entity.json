{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "eu_sc:soul_corrupted_phantom_green",
      "materials": {
        "default": "outline_base",
        "outline_main": "outline_main"
      },
      "textures": {
        "default": "textures/entity/soul_corrupted/soul_corrupted_phantom_green",
        "outline_main": "textures/entity/soul_corrupted/white_outline"
      },
      "geometry": {
        "default": "geometry.eu.sc.soul_corrupted_phantom",
        "outline_main": "geometry.eu.sc.soul_corrupted_phantom.outline"
      },
      "spawn_egg": {
        "base_color": "#94F7A4",
        "overlay_color": "#15B530"
      },
      "scripts": {
        "animate": [
          "emitter_particle_controller",
          "eu_sc_controller",
          "eu_sc_particles"
        ],
        "should_update_effects_offscreen": "1.0",
        "initialize": [
          "variable.s_speed = 0.0;",
          "variable.s_turn = 0.0;"
        ],
        "pre_animation": [
          "variable.s_speed = math.lerp(variable.s_speed, query.modified_move_speed, 0.1);",
          "variable.s_turn = math.lerp(variable.s_turn, math.clamp(query.yaw_speed, -120.0, 120.0), 0.05);"
        ]
      },
      "animations": {
        "emitter_particle_controller": "controller.animation.eu.emitter_particle",
        "eu_sc_controller": "controller.animation.eu_sc.phantom",
        "eu_sc_particles": "animation.eu_sc.particles",
        "phantom_spawn": "animation.eu_sc.phantom_spawn",
        "phantom_fly": "animation.eu_sc.phantom_fly"
      },
      "sound_effects": {
        "flap": "mob.phantom.flap"
      },
      "render_controllers": [
        "controller.render.eu_sc.outline_base.glow",
        "controller.render.eu_sc.outline_main.glow"
      ],
      "particle_effects": {
        "emitter": "eu_sc:soul_ascending_particle_green",
        "wisps": "eu_sc:wisp_green",
        "drips": "eu_sc:drip_green",
        "burst": "eu_sc:burst_green"
      }
    }
  }
}
