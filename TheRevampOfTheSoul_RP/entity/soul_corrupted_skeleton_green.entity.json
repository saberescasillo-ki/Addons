{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "eu_sc:soul_corrupted_skeleton_green",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "outline_base",
        "outline_main": "outline_main"
      },
      "textures": {
        "default": "textures/entity/soul_corrupted/soul_corrupted_skeleton_green",
        "outline_main": "textures/entity/soul_corrupted/white_outline"
      },
      "geometry": {
        "default": "geometry.eu.sc.soul_corrupted_skeleton",
        "outline_main": "geometry.eu.sc.soul_corrupted_skeleton.outline"
      },
      "spawn_egg": {
        "base_color": "#94F7A4",
        "overlay_color": "#15B530"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.riding_y_offset_with_respect_to_player = 0.5;",
          "variable.riding_y_offset_on_vehicle_where_other_entites_can_stand = query.is_riding_any_entity_of_type('minecraft:minecart', 'minecraft:boat', 'minecraft:chest_boat') ? -3.0 : 0.0;",
          "variable.riding_y_offset = variable.riding_y_offset_with_respect_to_player + variable.riding_y_offset_on_vehicle_where_other_entites_can_stand;",
          "variable.s_speed = math.lerp(variable.s_speed, query.modified_move_speed, 0.1);",
          "variable.s_turn = math.lerp(variable.s_turn, math.clamp(query.yaw_speed, -120.0, 120.0), 0.05);"
        ],
        "initialize": [
          "variable.s_speed = 0.0;",
          "variable.s_turn = 0.0;"
        ],
        "animate": [
          "emitter_particle_controller",
          "look_at_target",
          "move",
          "riding",
          "holding",
          "brandish_spear",
          "charging",
          "attack",
          "sneaking",
          "bob",
          "damage_nearby_mobs",
          "bow_and_arrow",
          "swimming",
          "use_item_progress",
          "skeleton_attack",
          "eu_sc_controller",
          "eu_sc_particles"
        ]
      },
      "particle_effects": {
        "emitter": "eu_sc:soul_ascending_particle_green",
        "wisps": "eu_sc:wisp_green",
        "drips": "eu_sc:drip_green",
        "burst": "eu_sc:burst_green"
      },
      "animations": {
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "move": "controller.animation.humanoid.move",
        "riding.arms": "animation.humanoid.riding.arms",
        "riding.legs": "animation.humanoid.riding.legs",
        "holding": "controller.animation.humanoid.holding",
        "brandish_spear": "controller.animation.humanoid.brandish_spear",
        "charging": "controller.animation.humanoid.charging",
        "attack.rotations": "animation.humanoid.attack.rotations",
        "sneaking": "controller.animation.humanoid.sneaking",
        "bob": "controller.animation.humanoid.bob",
        "damage_nearby_mobs": "controller.animation.humanoid.damage_nearby_mobs",
        "bow_and_arrow": "controller.animation.humanoid.bow_and_arrow",
        "swimming": "controller.animation.zombie.swimming",
        "use_item_progress": "controller.animation.humanoid.use_item_progress",
        "skeleton_attack": "controller.animation.skeleton.attack",
        "riding.body": "animation.humanoid.riding.body",
        "emitter_particle_controller": "controller.animation.eu.emitter_particle",
        "look_at_target": "controller.animation.humanoid.look_at_target",
        "riding": "controller.animation.humanoid.riding",
        "attack": "controller.animation.humanoid.attack",
        "eu_sc_controller": "controller.animation.eu_sc.skeleton",
        "eu_sc_particles": "animation.eu_sc.particles",
        "skeleton_spawn": "animation.eu_sc.skeleton_spawn",
        "skeleton_life": "animation.eu_sc.skeleton_life"
      },
      "render_controllers": [
        "controller.render.eu_sc.outline_base.glow",
        "controller.render.eu_sc.outline_main.glow"
      ],
      "enable_attachables": true
    }
