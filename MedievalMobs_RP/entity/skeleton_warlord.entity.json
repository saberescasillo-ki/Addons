{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "medieval:skeleton_warlord",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/medieval/skeleton_warlord"
      },
      "geometry": {
        "default": "geometry.medieval.skeleton_warlord"
      },
      "animations": {
        "look": "animation.medieval.look_at_target",
        "legs_walk": "animation.medieval.legs_walk",
        "arms_walk": "animation.medieval.arms_walk",
        "bow_aim": "animation.medieval.bow_aim",
        "attack_swing": "animation.medieval.attack_swing",
        "cape_sway": "animation.medieval.cape_sway"
      },
      "scripts": {
        "animate": [
          "look",
          "legs_walk",
          {
            "arms_walk": "!(query.has_target && query.mark_variant == 0)"
          },
          {
            "bow_aim": "query.has_target && query.mark_variant == 0"
          },
          "attack_swing",
          "cape_sway"
        ]
      },
      "render_controllers": [
        "controller.render.medieval.default"
      ],
      "spawn_egg": {
        "base_color": "#3a3d44",
        "overlay_color": "#d6a92e"
      },
      "enable_attachables": true
    }
  }
}
